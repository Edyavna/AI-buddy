# Local synthetic data only. Never put production keys in Git.
HTTP_ADDR=:8080
DEMO_MODE=true
DATABASE_ENABLED=true
DATABASE_URL=postgres://buddy:buddy_dev_only@localhost:5432/buddy?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
STARTUP_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
SESSION_TTL=24h
# Set true for HTTPS terminated at a trusted reverse proxy. Direct TLS also
# enables Secure automatically; arbitrary X-Forwarded-Proto is not trusted.
SESSION_COOKIE_SECURE=false
# Explicit synthetic chat only; production Agent is supplied separately.
DEMO_CHAT_DELAY=250ms

# Compose PostgreSQL credentials. If changed, also update local DATABASE_URL.
# For this local example use URL-safe user/password/database values.
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy_dev_only
POSTGRES_DB=buddy

# Planned agent/knowledge settings. The day-one server does not read these yet.
# Set real keys in local environment when the corresponding modules are connected.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=
