{
  "name": "ai-buddy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/shared/api/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "clsx": "^2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "^6.28.2",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^6.0.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
