{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["vitest/globals", "node"]
  },
  "include": ["src", "vitest.config.ts", "../contracts/examples/scenario.json"]
}
